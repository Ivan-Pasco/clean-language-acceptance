{
  "extraKnownMarketplaces": {
    "indra-software-factory": {
      "source": {
        "source": "github",
        "repo": "jpchauny/indra-software-factory"
      }
    }
  },
  "enabledPlugins": {
    "development-methodology@indra-software-factory": true,
    "utilities@indra-software-factory": true,
    "acceptance-management@indra-software-factory": true
  },
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git * commit *)",
      "Bash(git * push *)"
    ],
    "deny": [
      "Read(//**/clean-language-compiler/**)",
      "Edit(//**/clean-language-compiler/**)",
      "Read(//**/clean-host-core/**)",
      "Edit(//**/clean-host-core/**)",
      "Read(//**/clean-server/**)",
      "Edit(//**/clean-server/**)"
    ]
  }
}
